# NPS PAM Reporting API Configuration

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# NPS Configuration
NPS_SERVER=https://nps.company.com:6500
NPS_USERNAME=domain\\user
NPS_PASSWORD=your_password_here
NPS_MFA_ENABLED=true

# NPS PowerShell Module Path
NPS_MODULE_PATH=../nps-powershell-module/NPS-Module-Complete.psm1

# Cache Configuration (in milliseconds)
CACHE_TIMEOUT=60000

# Logging
LOG_LEVEL=info
